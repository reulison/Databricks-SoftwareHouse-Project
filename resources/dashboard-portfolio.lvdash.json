{
  "datasets": [
    {
      "name": "ds_projetos",
      "displayName": "Projetos em andamento",
      "queryLines": [
        "SELECT projeto_id, projeto, nome_projeto, cliente, segmento, tipo_projeto,\n",
        "ferramenta, gerente_projeto, valor_contrato, orcamento, pv, ev, ac,\n",
        "spi, cpi, eac, estouro_previsto, margem_projetada,\n",
        "atraso_projetado_dias, situacao, farol_do_gerente, farol_calculado,\n",
        "CASE WHEN melancia THEN 'sim' ELSE 'não' END AS melancia\n",
        "FROM projeto_situacao_atual\n",
        "WHERE status = 'em_andamento'\n",
        "ORDER BY estouro_previsto DESC\n"
      ],
      "columns": [
        {
          "displayName": "Carteira",
          "expression": "SUM(`valor_contrato`)"
        },
        {
          "displayName": "SPI",
          "expression": "SUM(`ev`) / SUM(`pv`)"
        },
        {
          "displayName": "CPI",
          "expression": "SUM(`ev`) / SUM(`ac`)"
        },
        {
          "displayName": "Estouro",
          "expression": "SUM(`estouro_previsto`)"
        },
        {
          "displayName": "Em Risco",
          "expression": "SUM(CASE WHEN `situacao` IN ('atenção','crítico') THEN 1 ELSE 0 END)"
        },
        {
          "displayName": "Críticos",
          "expression": "SUM(CASE WHEN `situacao` = 'crítico' THEN 1 ELSE 0 END)"
        },
        {
          "displayName": "Melancias",
          "expression": "SUM(CASE WHEN `melancia` = 'sim' THEN 1 ELSE 0 END)"
        }
      ]
    },
    {
      "name": "ds_estouro",
      "displayName": "Estouro previsto por projeto",
      "queryLines": [
        "SELECT projeto, situacao, estouro_previsto\n",
        "FROM projeto_situacao_atual\n",
        "WHERE status = 'em_andamento' AND estouro_previsto > 0\n",
        "ORDER BY estouro_previsto DESC\n"
      ]
    },
    {
      "name": "ds_serie",
      "displayName": "SPI e CPI semanais da carteira",
      "queryLines": [
        "SELECT semana,\n",
        "ROUND(SUM(ev) / SUM(pv), 4) AS spi,\n",
        "ROUND(SUM(ev) / SUM(ac), 4) AS cpi\n",
        "FROM fato_projeto_semana\n",
        "WHERE semana >= DATE'2025-03-07'\n",
        "GROUP BY semana\n",
        "ORDER BY semana\n"
      ]
    },
    {
      "name": "ds_pessoas_top",
      "displayName": "Top 15 pessoas por custo do ócio",
      "queryLines": [
        "SELECT nome, papel, colaborador_id,\n",
        "SUM(custo_ocioso) AS custo_ocioso,\n",
        "SUM(horas_ociosas) AS horas_ociosas,\n",
        "ROUND(SUM(horas_apontadas) / SUM(horas_disponiveis), 4) AS utilizacao\n",
        "FROM utilizacao_pessoa_semana\n",
        "WHERE semana > DATE'2026-07-24'\n",
        "GROUP BY nome, papel, colaborador_id\n",
        "ORDER BY custo_ocioso DESC\n",
        "LIMIT 15\n"
      ]
    },
    {
      "name": "ds_utilizacao",
      "displayName": "Utilização por pessoa e projeto",
      "queryLines": [
        "SELECT colaborador_id, nome, papel, projeto_id,\n",
        "SUM(horas_disponiveis) AS horas_disponiveis,\n",
        "SUM(horas_apontadas) AS horas_apontadas,\n",
        "SUM(horas_ociosas) AS horas_ociosas,\n",
        "SUM(custo_ocioso) AS custo_ocioso,\n",
        "ROUND(SUM(horas_apontadas) / SUM(horas_disponiveis), 4) AS utilizacao\n",
        "FROM utilizacao_pessoa_semana\n",
        "WHERE semana > DATE'2026-07-24'\n",
        "GROUP BY colaborador_id, nome, papel, projeto_id\n",
        "ORDER BY utilizacao ASC\n"
      ]
    },
    {
      "name": "ds_causas",
      "displayName": "Causas de bloqueio por projeto",
      "queryLines": [
        "WITH top_projetos AS (\n",
        "SELECT projeto_id, COUNT(*) AS bloqueios\n",
        "FROM status_estruturado\n",
        "WHERE data_status >= DATE'2026-07-18'\n",
        "AND causa_bloqueio NOT IN ('sem_bloqueio', 'nao_reportado')\n",
        "GROUP BY projeto_id\n",
        "ORDER BY bloqueios DESC\n",
        "LIMIT 12\n",
        ")\n",
        "SELECT p.projeto, s.causa_bloqueio, COUNT(*) AS bloqueios\n",
        "FROM status_estruturado s\n",
        "JOIN top_projetos t ON t.projeto_id = s.projeto_id\n",
        "JOIN projeto_situacao_atual p ON p.projeto_id = s.projeto_id\n",
        "WHERE s.data_status >= DATE'2026-07-18'\n",
        "AND s.causa_bloqueio NOT IN ('sem_bloqueio', 'nao_reportado')\n",
        "GROUP BY p.projeto, s.causa_bloqueio\n",
        "ORDER BY p.projeto, s.causa_bloqueio\n"
      ]
    },
    {
      "name": "ds_fornecedor",
      "displayName": "Fornecedores",
      "queryLines": [
        "SELECT fornecedor,\n",
        "COUNT(DISTINCT fornecedor_como_veio) AS grafias,\n",
        "COUNT(*) AS entregas,\n",
        "ROUND(AVG(prazo_real_dias / prazo_prometido_dias), 2) AS prazo_real_sobre_prometido,\n",
        "ROUND(SUM(CASE WHEN status = 'entregue' AND prazo_real_dias <= prazo_prometido_dias THEN 1 ELSE 0 END)\n",
        "/ COUNT(CASE WHEN status = 'entregue' THEN 1 END), 3) AS pct_no_prazo,\n",
        "SUM(CASE WHEN em_atraso THEN 1 ELSE 0 END) AS em_atraso_hoje\n",
        "FROM lakehouse_vertice.silver.entregas_fornecedor\n",
        "GROUP BY fornecedor\n",
        "ORDER BY entregas DESC\n"
      ]
    },
    {
      "name": "ds_atrasos",
      "displayName": "Entregas em atraso hoje",
      "queryLines": [
        "SELECT entrega_id, projeto_id, fornecedor, item, data_prometida,\n",
        "prazo_prometido_dias,\n",
        "DATEDIFF(DATE'2026-10-16', data_prometida) AS dias_de_atraso_hoje\n",
        "FROM lakehouse_vertice.silver.entregas_fornecedor\n",
        "WHERE em_atraso\n",
        "ORDER BY data_prometida\n"
      ]
    }
  ],
